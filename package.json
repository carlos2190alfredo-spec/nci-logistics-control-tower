{
  "name": "logistics-control-tower",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:local": "pnpm install && pnpm local:up && pnpm storage:init && pnpm db:migrate && pnpm db:seed",
    "local:up": "docker compose up -d postgres minio mailpit",
    "local:down": "docker compose down",
    "local:logs": "docker compose logs -f",
    "local:reset": "docker compose down -v && docker compose up -d postgres minio mailpit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "db:studio": "prisma studio",
    "storage:init": "tsx scripts/storage-init.ts",
    "backup:create": "bash scripts/backup-create.sh",
    "backup:restore": "bash scripts/backup-restore.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "security:check": "tsx scripts/security-check.ts",
    "security:test": "playwright test tests/e2e/offline-sync.spec.ts tests/e2e/file-security.spec.ts",
    "security:audit": "pnpm audit --prod || true",
    "files:health": "tsx scripts/files-health.ts",
    "files:test:eicar": "tsx scripts/files-test-eicar.ts",
    "files:cleanup": "tsx scripts/files-cleanup.ts",
    "files:cleanup:dry-run": "tsx scripts/files-cleanup.ts --dry-run",
    "files:migrate-legacy": "tsx scripts/files-migrate-legacy.ts",
    "files:migrate-legacy:dry-run": "tsx scripts/files-migrate-legacy.ts --dry-run",
    "test:e2e:files": "playwright test tests/e2e/file-security.spec.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1083.0",
    "@aws-sdk/s3-request-presigner": "3.1083.0",
    "@prisma/client": "6.19.1",
    "argon2": "0.44.0",
    "clsx": "2.1.1",
    "geist": "1.5.1",
    "lucide-react": "0.562.0",
    "next": "16.2.10",
    "nodemailer": "9.0.3",
    "otpauth": "^9.5.1",
    "pdfkit": "0.17.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.4.0",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "20.19.43",
    "@types/nodemailer": "7.0.4",
    "@types/pdfkit": "0.17.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "jsdom": "27.3.0",
    "prettier": "3.7.4",
    "prisma": "6.19.1",
    "tailwindcss": "4.3.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  }
}
