# =============================================================================
# NCI Logistics Control Tower — Environment Variables Template
# =============================================================================
# Copy this file to .env.local for local development, or configure these values
# in your production secret manager (AWS SSM, Doppler, Vault, GitHub Actions
# secrets, etc). NEVER commit real secrets to the repository.
#
# Generate secrets with:  openssl rand -hex 32
# =============================================================================

# -----------------------------------------------------------------------------
# Core (required)
# -----------------------------------------------------------------------------

# Public URL. Used to build email verification and password reset links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node environment. Set to "production" in production deployments.
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------

# PostgreSQL connection string.
# Local:      postgresql://nci:nci_local_password@localhost:5433/nci_logistics?schema=public
# Production: use a managed Postgres (RDS, Cloud SQL, Supabase, Neon).
DATABASE_URL="postgresql://nci:nci_local_password@localhost:5433/nci_logistics?schema=public"

# Override host port when running local Postgres via docker compose.
POSTGRES_HOST_PORT="5433"

# -----------------------------------------------------------------------------
# Session & Encryption (required)
# -----------------------------------------------------------------------------

# 64-character hex (32 bytes) used to sign session cookies.
SESSION_SECRET="replace-with-openssl-rand-hex-32"

# Cookie name.
SESSION_COOKIE_NAME="nci_lct_session"

# Optional 64-character hex for encrypting session metadata (device, IP).
SESSION_METADATA_KEY=""

# 64-character hex used to encrypt MFA TOTP secrets at rest.
# WARNING: rotating invalidates all existing MFA enrollments.
MFA_ENCRYPTION_KEY="replace-with-openssl-rand-hex-32"

# 64-character hex used to encrypt integration credentials at rest.
INTEGRATION_ENCRYPTION_KEY=""

# 64-character hex used to encrypt database and object-storage backups.
# WARNING: losing this key makes existing backups unrecoverable. Store offsite.
BACKUP_ENCRYPTION_KEY=""

# -----------------------------------------------------------------------------
# Mail — SMTP (required)
# -----------------------------------------------------------------------------

# SMTP server.
# Local (Mailpit):  MAIL_HOST=localhost, MAIL_PORT=1025, no auth needed.
# Production examples:
#   AWS SES:  MAIL_HOST=email-smtp.us-east-1.amazonaws.com, MAIL_PORT=587
#   SendGrid: MAIL_HOST=smtp.sendgrid.net, MAIL_PORT=587, MAIL_USER=apikey
#   Postmark: MAIL_HOST=smtp.postmarkapp.com, MAIL_PORT=587
#   Resend:   MAIL_HOST=smtp.resend.com, MAIL_PORT=587, MAIL_USER=resend
MAIL_HOST="localhost"
MAIL_PORT="1025"

# TLS. Auto true on 465. Set explicitly for STARTTLS on 587.
MAIL_SECURE="false"

# SMTP auth (leave empty for local Mailpit).
MAIL_USER=""
MAIL_PASSWORD=""

# From address. Must be a verified sender in production.
MAIL_FROM="NCI Logistics Control Tower <no-reply@nci.local>"

# -----------------------------------------------------------------------------
# Object Storage — S3 / MinIO (required)
# -----------------------------------------------------------------------------

# S3-compatible endpoint.
# Local MinIO: http://localhost:9000
# AWS S3:      https://s3.<region>.amazonaws.com
MINIO_ENDPOINT="http://localhost:9000"

# Internal endpoint used inside docker network (when app runs in the same compose).
MINIO_INTERNAL_ENDPOINT="http://minio:9000"

# Access credentials.
MINIO_ACCESS_KEY="nci_minio"
MINIO_SECRET_KEY="nci_minio_password"

# Bucket for uploaded files (evidence photos, POD PDFs).
MINIO_BUCKET="nci-logistics-local"

# -----------------------------------------------------------------------------
# Antivirus — ClamAV (required for file uploads)
# -----------------------------------------------------------------------------

CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"

# -----------------------------------------------------------------------------
# AI Provider — DeepSeek (optional; rules-based fallback active without it)
# -----------------------------------------------------------------------------

# Provider: "disabled" (default), "auto", "deepseek".
AI_PROVIDER="disabled"

# Only DEEPSEEK_API_KEY is required to enable; the rest have defaults.
DEEPSEEK_API_KEY=""
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_MODEL="deepseek-v4-pro"
# DEEPSEEK_REASONING_EFFORT="high"
# DEEPSEEK_THINKING_ENABLED="true"
# DEEPSEEK_TIMEOUT_MS="25000"
# DEEPSEEK_MAX_OUTPUT_TOKENS="1500"

# -----------------------------------------------------------------------------
# Route Estimation — Google Maps (optional)
# -----------------------------------------------------------------------------

# Mode: "disabled" (default), "simulated", "google", "waze-stub".
GOOGLE_MAPS_ROUTES_MODE="disabled"

# Required only when GOOGLE_MAPS_ROUTES_MODE="google".
GOOGLE_MAPS_API_KEY=""

# -----------------------------------------------------------------------------
# Security & CORS (production)
# -----------------------------------------------------------------------------

# Comma-separated allowed origins for the offline-sync endpoint.
# Example: "https://app.nci.example,https://driver.nci.example"
ALLOWED_ORIGINS=""

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------

# Debug logs. Do NOT enable long-term in production.
DEBUG=""

# Git SHA baked into logs and health endpoint. Set by CI.
COMMIT_SHA=""
