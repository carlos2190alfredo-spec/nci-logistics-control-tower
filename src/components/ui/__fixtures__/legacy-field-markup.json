  "portalDestino": "<form><div class=\"grid gap-1.5\"><label class=\"text-sm font-medium text-foreground\" for=\"ID\">Destino<span aria-hidden=\"true\" class=\"ml-0.5 text-danger\">*</span></label><input class=\"min-h-10 w-full rounded-lg border border-border bg-surface px-3 py-2 text-foreground shadow-xs transition-colors duration-150 placeholder:text-faint-foreground hover:border-border-strong focus:border-primary\" id=\"ID\" placeholder=\"Terminal, puerto o dirección de entrega\" required=\"\" type=\"text\" name=\"destination\" value=\"Puerto de Balboa\"/></div></form>",
