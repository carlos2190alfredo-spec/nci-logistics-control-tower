{
  "containersReferencia": "<form><div class=\"grid gap-1.5\"><label class=\"text-sm font-medium text-foreground\" for=\"ID\">Referencia<span aria-hidden=\"true\" class=\"ml-0.5 text-danger\">*</span></label><input class=\"min-h-10 w-full rounded-lg border border-border bg-surface px-3 py-2 text-foreground shadow-xs transition-colors duration-150 placeholder:text-faint-foreground hover:border-border-strong focus:border-primary\" id=\"ID\" placeholder=\"EMPRESA-CT-0001\" required=\"\" type=\"text\" name=\"reference\"/></div></form>",
  "containersFreeDays": "<form><div class=\"grid gap-1.5\"><label class=\"text-sm font-medium text-foreground\" for=\"ID\">Días libres</label><input aria-describedby=\"ID-help\" class=\"min-h-10 w-full rounded-lg border border-border bg-surface px-3 py-2 text-foreground shadow-xs transition-colors duration-150 placeholder:text-faint-foreground hover:border-border-strong focus:border-primary\" id=\"ID\" type=\"number\" name=\"freeDays\"/><p class=\"text-xs text-muted-foreground\" id=\"ID-help\">Días libres pactados para demurrage/detention.</p></div></form>",
