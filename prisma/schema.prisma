  updatedAt       DateTime  @updatedAt @map("updated_at")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver          Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([tenantId, driverId, dayOfWeek])
  @@index([tenantId, driverId])
  @@map("driver_work_schedules")
}

model DriverAvailabilityException {
  id              String                     @id @default(uuid()) @db.Uuid
  tenantId        String                     @map("tenant_id") @db.Uuid
  driverId        String                     @map("driver_id") @db.Uuid
  date            DateTime                   @db.Date
  type            AvailabilityExceptionType
  startTimeLocal  String?                    @map("start_time_local")
  endTimeLocal    String?                    @map("end_time_local")
  reason          String?
  createdAt       DateTime                   @default(now()) @map("created_at")
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver          Driver                     @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([tenantId, driverId, date])
  @@map("driver_availability_exceptions")
}

// ─── Driver Assignment Recommendations ──────────────────────

enum RecommendationStatus {
  GENERATED
  ACCEPTED
  DISMISSED
  OVERRIDDEN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RecommendationGeneratedBy {
  RULES_ENGINE
  AI_DISABLED_PROVIDER
  AI_PROVIDER_FUTURE
}

model DriverAssignmentRecommendation {
  id                  String                     @id @default(uuid()) @db.Uuid
  tenantId            String                     @map("tenant_id") @db.Uuid
  tripId              String                     @map("trip_id") @db.Uuid
  driverId            String?                    @map("driver_id") @db.Uuid
  status              RecommendationStatus       @default(GENERATED)
  score               Float
  rank                Int
  recommendationTitle String                     @map("recommendation_title")
  explanation         String
  riskLevel           RiskLevel                  @map("risk_level")
  reasonsJson         Json                       @default("[]") @map("reasons_json")
  warningsJson        Json                       @default("[]") @map("warnings_json")
  generatedBy         RecommendationGeneratedBy  @map("generated_by")
  overrideReason      String?                    @map("override_reason")
  acceptedAt          DateTime?                  @map("accepted_at")
  dismissedAt         DateTime?                  @map("dismissed_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  tenant              Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip                Trip                       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver              Driver?                    @relation(fields: [driverId], references: [id])

  @@index([tenantId, tripId])
  @@index([tenantId, driverId])
  @@map("driver_assignment_recommendations")
}

// ─── Product Evolution: Invitations ──────────────────────────

model UserInvitation {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  email        String
  role         TenantRole
  tokenHash    String     @unique @map("token_hash")
  expiresAt    DateTime   @map("expires_at")
  usedAt       DateTime?  @map("used_at")
  invitedById  String     @map("invited_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy    User       @relation("InvitationsSent", fields: [invitedById], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId, expiresAt])
  @@map("user_invitations")
}

// ─── DeepSeek / AI Provider Tracking ────────────────────────

model AiInvocation {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  requestId         String   @map("request_id")
  provider          String
  model             String
  purpose           String
  status            String
  inputCharCount    Int      @default(0) @map("input_char_count")
  outputCharCount   Int      @default(0) @map("output_char_count")
  promptTokens      Int      @default(0) @map("prompt_tokens")
  completionTokens  Int      @default(0) @map("completion_tokens")
  totalTokens       Int      @default(0) @map("total_tokens")
  durationMs        Int      @map("duration_ms")
  fallbackUsed      Boolean  @default(false) @map("fallback_used")
  errorCode         String?  @map("error_code")
  safeErrorMessage  String?  @map("safe_error_message")
  createdAt         DateTime @default(now()) @map("created_at")
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, purpose])
  @@map("ai_invocations")
}

model AiUsageDaily {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  date             DateTime @db.Date
  requestCount     Int      @default(0) @map("request_count")
  successCount     Int      @default(0) @map("success_count")
  failureCount     Int      @default(0) @map("failure_count")
  fallbackCount    Int      @default(0) @map("fallback_count")
  blockedCount     Int      @default(0) @map("blocked_count")
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date], name: "tenantId_date")
  @@map("ai_usage_daily")
}
